# Contact-form endpoint. Create a form at https://formspree.io, then paste its
# URL here as .env (this file is only the template).
#
# The form id is public by design — it ships in the client bundle — so this is
# a convenience for switching between a test and a live form, not a secret.
VITE_FORM_ENDPOINT=https://formspree.io/f/your_form_id

# Only needed if the site is not served from https://sammiee.dev
# SITE_URL=https://sammiee.dev
